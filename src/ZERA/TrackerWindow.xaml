<Window x:Class="ZERA.TrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tracker 管理" MinWidth="640" MinHeight="480" Background="{DynamicResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20" MinHeight="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="手动 Tracker 列表" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="每行一条，支持 UDP / HTTP / HTTPS；与已启用订阅合并去重。" Style="{StaticResource TertiaryText}" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="ManualBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Style="{StaticResource AppTextBox}" AutomationProperties.Name="手动 Tracker 列表"/>
        <DockPanel Grid.Row="2" Margin="0,14,0,8">
            <TextBlock Text="列表订阅" Style="{StaticResource PageTitleText}"/>
            <CheckBox x:Name="AutoBox" Content="每天自动检查更新" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView Grid.Row="3" x:Name="SubscriptionsList" MinHeight="100" SelectionChanged="OnSelect"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}">
            <ListView.View><GridView>
                <GridViewColumn Header="名称" Width="140" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="状态 / 上次成功更新" Width="250" DisplayMemberBinding="{Binding Summary}"/>
                <GridViewColumn Header="订阅地址" Width="310" DisplayMemberBinding="{Binding Url}"/>
            </GridView></ListView.View>
        </ListView>
        <StackPanel Grid.Row="4" Margin="0,10,0,0" x:Name="EditorPanel">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="名称" VerticalAlignment="Center" Style="{StaticResource TertiaryText}"/>
                <TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource AppTextBox}" MaxLength="80" AutomationProperties.Name="订阅名称"/>
                <CheckBox Grid.Column="2" x:Name="EnabledBox" Content="启用" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="地址" VerticalAlignment="Center" Style="{StaticResource TertiaryText}"/>
                <TextBox Grid.Column="1" x:Name="UrlBox" Style="{StaticResource AppTextBox}" AutomationProperties.Name="GitHub Tracker 订阅地址"/>
            </Grid>
            <TextBlock Text="支持 GitHub 文件页面、raw 原始地址及 HTTPS 纯文本地址。修改后点击“更新所选”；新增前点击“新建”。" TextWrapping="Wrap" Style="{StaticResource TertiaryText}" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="新建" Click="OnNew" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="UpsertButton" Content="添加订阅" Click="OnUpsert" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="删除所选" Click="OnRemove" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="添加常用 GitHub 源" Click="OnDefaults" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" Style="{StaticResource TertiaryText}"/>
            <TextBlock Text="保存后用于新建下载任务，已有任务保留原列表。私有 .torrent 不追加；磁力获取元数据前无法判断是否私有。自动更新仅在程序运行且打开过 BT 窗口时检查，失败保留缓存。" TextWrapping="Wrap" Style="{StaticResource TertiaryText}" Margin="0,5,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton" Content="保存并立即更新订阅" Click="OnUpdate" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="保存并关闭" Click="OnSave" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
