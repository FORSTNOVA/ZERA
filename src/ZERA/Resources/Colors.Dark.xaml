<!--
    Colors.Dark.xaml —— 深色主题设计令牌（「深空」）
    ============================================================
    整套配色采用深邃宁静的深空蓝黑底与高可辨识度星蓝主色。
    满足 WCAG 对比度规范，且与浅色主题 36 个令牌逐键严格对应。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ────────── 背景 / 表面（同一深空蓝黑相） -->
    <Color x:Key="AppBgColor">#FF0B101E</Color>
    <Color x:Key="SurfaceColor">#FF131A2E</Color>
    <Color x:Key="SurfaceAltColor">#FF1B243D</Color>
    <Color x:Key="SurfaceSunkenColor">#FF080C17</Color>

    <!-- ────────── 主色（深空冷星蓝，全应用唯一强调色） -->
    <Color x:Key="PrimaryColor">#FF6489FF</Color>
    <Color x:Key="PrimaryHoverColor">#FF7B9CFF</Color>
    <Color x:Key="PrimaryPressedColor">#FF5075F0</Color>
    <Color x:Key="PrimaryLightColor">#FF192347</Color>
    <Color x:Key="PrimarySoftColor">#FF223060</Color>

    <!-- ────────── 语义色 -->
    <Color x:Key="SuccessColor">#FF34D388</Color>
    <Color x:Key="SuccessLightColor">#FF0E261D</Color>
    <Color x:Key="WarningColor">#FFF5B438</Color>
    <Color x:Key="WarningLightColor">#FF2C210C</Color>
    <Color x:Key="DangerColor">#FFFF6666</Color>
    <Color x:Key="DangerLightColor">#FF331518</Color>

    <!-- ────────── 文字 -->
    <Color x:Key="TextPrimaryColor">#FFEBF0FA</Color>
    <Color x:Key="TextSecondaryColor">#FFA4B0CE</Color>
    <Color x:Key="TextTertiaryColor">#FF7E8BAF</Color>
    <!-- 深色主题主色为亮蓝，其上文字必须使用深底色以满足对比度 -->
    <Color x:Key="TextOnPrimaryColor">#FF0B101E</Color>

    <!-- ────────── 阴影 -->
    <Color x:Key="ShadowColor">#FF000000</Color>
    <Color x:Key="ShadowStrongColor">#FF000000</Color>

    <!-- ────────── 头像底色 -->
    <Color x:Key="AvatarTint1Color">#FF6489FF</Color>
    <Color x:Key="AvatarTint2Color">#FF9A7DF5</Color>
    <Color x:Key="AvatarTint3Color">#FF36C7C7</Color>
    <Color x:Key="AvatarTint4Color">#FFFF9B6D</Color>
    <Color x:Key="AvatarTint5Color">#FFFF78A1</Color>

    <!-- ────────── 容量占用率色阶 -->
    <Color x:Key="CapacityLowColor">#FF34D388</Color>
    <Color x:Key="CapacityMidColor">#FFF5B438</Color>
    <Color x:Key="CapacityHighColor">#FFFF6666</Color>

    <!-- ────────── 描边 / 分隔 -->
    <Color x:Key="BorderColor">#FF222D4B</Color>
    <Color x:Key="BorderStrongColor">#FF52649B</Color>

    <!-- ────────── 滚动条 -->
    <Color x:Key="ScrollThumbColor">#FF323D61</Color>
    <Color x:Key="ScrollThumbHoverColor">#FF485785</Color>

    <!-- ────────── 标题栏 -->
    <Color x:Key="TitleBarColor">#FF0E1425</Color>
    <Color x:Key="TitleBarHoverColor">#FF1A233C</Color>
    <Color x:Key="TitleBarCloseHoverColor">#FFD62E3D</Color>

</ResourceDictionary>
