<!--
    Starfield.Light.xaml —— 亮色主题的星空背景层（画刷）
    ============================================================
    【2026-10-14 星空主题改版】与 Starfield.Dark.xaml 对应，见那边的完整说明。

    亮色版刻意做得**极淡**：基色 #EDF1FB（= Colors.Light 的 AppBgColor），
    星点只有 40 颗、透明度 55~130。原因很直接 —— 亮色下文字是深色的，
    背景一旦有对比强烈的元素就会啃字；这里要的是"天边还有几颗没退场的星"
    这种暗示，而不是真的星空。

    SidebarBrush 这里**故意不给星空**，直接给纯白（= SurfaceColor）：
    亮色下侧栏已经是纯白卡片，再铺一层极淡的星点只会让它显得脏，
    而且和深色版的"侧栏也有星空"不对等 —— 但观感上深色侧栏的星空是点缀，
    亮色侧栏的干净是克制，两边各自成立。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 内容区：晨曦天穹 + 极淡星点 -->
    <ImageBrush x:Key="AppBgBrush"
                ImageSource="/ZERA;component/Resources/starfield-light.png"
                TileMode="Tile"
                ViewportUnits="Absolute"
                Viewport="0,0,512,512"
                Stretch="Fill"
                AlignmentX="Left" AlignmentY="Top"/>

    <!-- 侧栏：纯白（与 SurfaceColor 一致，见文件头说明） -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFFFF"/>

</ResourceDictionary>
