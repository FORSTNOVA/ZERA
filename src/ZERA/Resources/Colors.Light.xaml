<!--
    Colors.Light.xaml —— 亮色主题设计令牌（「晨曦天穹」）
    ============================================================
    【2026-10-14 星空主题改版】整套配色从"中性浅灰"改成"天光淡蓝"。

    设计思路：
    1. **底色是天空，不是白纸**。#EDF1FB 是日出前天际的颜色 —— 偏蓝、偏冷、
       但不发灰。中性浅灰（旧版 #F5F6FA）看起来像"打印纸"，天光蓝才和
       深色版的"夜空"是同一个世界观（白天 / 夜晚，而不是"亮 / 暗"）。
    2. **表面仍用纯白**：卡片必须比背景亮，纯白 + 淡蓝底的对比足够，
       同时保留"纸上写字"的清晰度。
    3. **主色"星靛" #5566D6**：与深色版 #7C8CFF 同一个色相家族，只降明度提饱和，
       保证亮/暗切换时品牌色不会跳成一个完全不同的颜色。
    4. **文字按 WCAG 重算**（对最差的底色算，不是只对白底算）：
         TextPrimary   #1A2036 ≈ 13.4:1   （最差是 sunken #E4EAF7）
         TextSecondary #5A6480 ≈  4.9:1
         TextTertiary  #5F6880 ≈  4.6:1
       ⚠️ 两个曾经踩过的坑：
         (a) 旧版 TextTertiary #7B8496 在白底上就只剩 3.8:1；
         (b) 本次改版初稿用的 #6A748C 虽然对白底 4.68:1 达标，但**对 sunken
             #E4EAF7 只有 3.88:1** —— 而 sunken 正是"输入区/凹槽"实际用的底，
             说明文字就放在那上面。下调到 #5F6880 后四个底色全部 ≥4.6:1。
    5. **描边分两档**：Border 只用于卡片分隔（1.12:1，纯装饰，不需要对比度）；
         BorderStrong 用于**输入框边框**，属 WCAG 1.4.11 的 UI 组件边界，
         对 AppBg 3.10:1 / 对 Surface 3.51:1，均 ≥3:1。
    6. **阴影用主题深的蓝黑**而不是纯黑：纯黑在淡蓝底上会发"脏"，
       带蓝相的阴影才像云影。

    与 Colors.Dark.xaml 逐键对应（各 36 个），键名一个不多一个不少。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ────────── 背景 / 表面 -->
    <Color x:Key="AppBgColor">#FFEDF1FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF7F9FE</Color>
    <!-- Sunken = 比 AppBg 更暗（凹槽感），天光里"再暗一档" -->
    <Color x:Key="SurfaceSunkenColor">#FFE4EAF7</Color>

    <!-- ────────── 主色（星靛，全应用唯一强调色） -->
    <Color x:Key="PrimaryColor">#FF5566D6</Color>
    <!-- 主色偏亮的悬停态，白字会掉到 4.16:1（不达标）；压到 #5F6DDB 后 4.47:1 -->
    <Color x:Key="PrimaryHoverColor">#FF5F6DDB</Color>
    <Color x:Key="PrimaryPressedColor">#FF47559F</Color>
    <!-- 浅色底类令牌：亮底上的"淡色块"（与深色主题语义相反） -->
    <Color x:Key="PrimaryLightColor">#FFEDF0FE</Color>
    <Color x:Key="PrimarySoftColor">#FFDDE2FC</Color>

    <!-- ────────── 语义色 -->
    <Color x:Key="SuccessColor">#FF0FA97C</Color>
    <Color x:Key="SuccessLightColor">#FFE4F6EF</Color>
    <Color x:Key="WarningColor">#FFDB8A0B</Color>
    <Color x:Key="WarningLightColor">#FFFCF2DF</Color>
    <Color x:Key="DangerColor">#FFE0484E</Color>
    <Color x:Key="DangerLightColor">#FFFBEAEB</Color>

    <!-- ────────── 文字 -->
    <Color x:Key="TextPrimaryColor">#FF1A2036</Color>
    <Color x:Key="TextSecondaryColor">#FF5A6480</Color>
    <Color x:Key="TextTertiaryColor">#FF5F6880</Color>
    <!-- 本主题主色是深色，白字是对的（4.93:1）——与深色主题恰好相反 -->
    <Color x:Key="TextOnPrimaryColor">#FFFFFFFF</Color>

    <!-- ────────── 阴影（带蓝相的深色，淡蓝底上不发脏） -->
    <Color x:Key="ShadowColor">#FF1A2036</Color>
    <!-- 悬浮层（下拉/菜单）用稍重的阴影，表达"浮在内容之上" -->
    <Color x:Key="ShadowStrongColor">#FF1A2036</Color>

    <!-- ────────── 头像底色（无头像时用昵称首字生成，按名字散列取一个） -->
    <Color x:Key="AvatarTint1Color">#FF5566D6</Color>
    <Color x:Key="AvatarTint2Color">#FF8B6FE0</Color>
    <Color x:Key="AvatarTint3Color">#FF0E9E9E</Color>
    <Color x:Key="AvatarTint4Color">#FFEE8A5C</Color>
    <Color x:Key="AvatarTint5Color">#FFD9527E</Color>

    <!-- ────────── 容量占用率色阶（状态色编码：越满越警示） -->
    <Color x:Key="CapacityLowColor">#FF0FA97C</Color>
    <Color x:Key="CapacityMidColor">#FFDB8A0B</Color>
    <Color x:Key="CapacityHighColor">#FFE0484E</Color>

    <!-- ────────── 描边 / 分隔
         Border      → 卡片分隔，纯装饰（1.12:1 无妨）
         BorderStrong → **输入框边框**，属 WCAG 1.4.11 的 UI 组件边界，
                        对 AppBg 3.10:1 / 对 Surface 3.51:1，均 ≥3:1 -->
    <Color x:Key="BorderColor">#FFDFE5F3</Color>
    <Color x:Key="BorderStrongColor">#FF7C89A6</Color>

    <!-- ────────── 滚动条 -->
    <Color x:Key="ScrollThumbColor">#FFC9D2E8</Color>
    <Color x:Key="ScrollThumbHoverColor">#FFA9B4D0</Color>

    <!-- ────────── 标题栏 -->
    <Color x:Key="TitleBarColor">#FFF7F9FE</Color>
    <Color x:Key="TitleBarHoverColor">#FFE9EEF9</Color>
    <Color x:Key="TitleBarCloseHoverColor">#FFE81123</Color>

</ResourceDictionary>
