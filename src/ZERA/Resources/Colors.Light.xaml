<!--
    Colors.Light.xaml —— 亮色主题设计令牌（「晨曦天穹」）
    ============================================================
    整套配色采用平静柔和的天光蓝底与现代星靛蓝强调色。
    资源键与深色主题对应，供主题切换时保持一致的控件结构。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ────────── 背景 / 表面 -->
    <Color x:Key="AppBgColor">#FFF0F4FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF7FAFD</Color>
    <Color x:Key="SurfaceSunkenColor">#FFE5ECF6</Color>

    <!-- ────────── 主色（星靛蓝，清澈沉稳的现代蓝） -->
    <Color x:Key="PrimaryColor">#FF3B6FE8</Color>
    <Color x:Key="PrimaryHoverColor">#FF4D7DF0</Color>
    <Color x:Key="PrimaryPressedColor">#FF2E5ED8</Color>
    <Color x:Key="PrimaryLightColor">#FFECF2FE</Color>
    <Color x:Key="PrimarySoftColor">#FFDBE5FC</Color>

    <!-- ────────── 语义色 -->
    <Color x:Key="SuccessColor">#FF0FA97C</Color>
    <Color x:Key="SuccessLightColor">#FFE6F7F1</Color>
    <Color x:Key="WarningColor">#FFD98205</Color>
    <Color x:Key="WarningLightColor">#FFFDF4E3</Color>
    <Color x:Key="DangerColor">#FFE04349</Color>
    <Color x:Key="DangerLightColor">#FFFCEAEB</Color>

    <!-- ────────── 文字 -->
    <Color x:Key="TextPrimaryColor">#FF192138</Color>
    <Color x:Key="TextSecondaryColor">#FF53607E</Color>
    <Color x:Key="TextTertiaryColor">#FF6E7B99</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFFFF</Color>

    <!-- ────────── 阴影 -->
    <Color x:Key="ShadowColor">#18192138</Color>
    <Color x:Key="ShadowStrongColor">#26192138</Color>

    <!-- ────────── 头像底色 -->
    <Color x:Key="AvatarTint1Color">#FF3B6FE8</Color>
    <Color x:Key="AvatarTint2Color">#FF8260E6</Color>
    <Color x:Key="AvatarTint3Color">#FF0CA4A4</Color>
    <Color x:Key="AvatarTint4Color">#FFE88050</Color>
    <Color x:Key="AvatarTint5Color">#FFD94875</Color>

    <!-- ────────── 容量占用率色阶 -->
    <Color x:Key="CapacityLowColor">#FF0FA97C</Color>
    <Color x:Key="CapacityMidColor">#FFD98205</Color>
    <Color x:Key="CapacityHighColor">#FFE04349</Color>

    <!-- ────────── 描边 / 分隔 -->
    <Color x:Key="BorderColor">#FFDEE5F2</Color>
    <Color x:Key="BorderStrongColor">#FF8C9BB7</Color>

    <!-- ────────── 滚动条 -->
    <Color x:Key="ScrollThumbColor">#FFC8D2E6</Color>
    <Color x:Key="ScrollThumbHoverColor">#FFA8B6D2</Color>

    <!-- ────────── 标题栏 -->
    <Color x:Key="TitleBarColor">#FFF7FAFD</Color>
    <Color x:Key="TitleBarHoverColor">#FFE9EFFB</Color>
    <Color x:Key="TitleBarCloseHoverColor">#FFE81123</Color>

</ResourceDictionary>
