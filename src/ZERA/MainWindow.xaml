<Window x:Class="ZERA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ZERA · 多网盘下载助手"
        Icon="/Resources/app.ico"
        Height="780" Width="1140"
        MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="OnWindowClosing"
        KeyDown="OnWorkspaceKeyDown">

    <!-- 自绘无边框窗口：保留原生吸附、拖拽和双击最大化 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 0. 自定义标题栏 ================= -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ZERA" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{DynamicResource BorderBrushStrong}" Margin="10,0" Opacity="0.5" VerticalAlignment="Center" />
                        <TextBlock Text="多网盘下载助手" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最小化" Click="OnMinimizeClick" ToolTip="最小化">
                            <Path Data="{StaticResource IconMinimize}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最大化或还原" Click="OnMaximizeClick" ToolTip="最大化 / 还原">
                            <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Stretch="Uniform" Width="11" Height="11" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CaptionCloseButton}" AutomationProperties.Name="关闭窗口" Click="OnCloseClick" ToolTip="关闭">
                            <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 1. 主工作区：左侧导航 + 右侧内容 ================= -->
            <Grid Grid.Row="1" x:Name="MainWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ────────── 左侧侧边栏 ────────── -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="16" Margin="10,10,0,10" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 品牌区 -->
                            <RowDefinition Height="*" />     <!-- 导航菜单 -->
                            <RowDefinition Height="Auto" />  <!-- 快捷提示 -->
                            <RowDefinition Height="Auto" />  <!-- 账号卡片 -->
                        </Grid.RowDefinitions>

                        <!-- 品牌头部 -->
                        <StackPanel Grid.Row="0" Margin="18,18,18,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Resources/app-logo.png" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ZERA" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Path Data="{StaticResource IconStar}" Stretch="Uniform" Width="10" Height="10" Margin="6,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Button x:Name="AboutBtn" Click="OnAboutClick" Style="{StaticResource IconGhostButton}" Width="18" Height="18" Margin="4,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="关于" ToolTip="关于 ZERA / 赞赏支持">
                                            <Path Data="{StaticResource IconHelpCircle}" Stretch="Uniform" Width="13" Height="13" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                <Path.RenderTransform>
                                                    <TranslateTransform X="0" Y="1" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="多网盘下载助手" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 导航列表 -->
                        <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavListBox}" ItemContainerStyle="{StaticResource NavListItem}" SelectionChanged="OnNavSelectionChanged" Margin="12,6,12,0" VerticalAlignment="Top">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource NavItemIcon}" />
                                    <TextBlock Text="下载" Style="{StaticResource NavItemText}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconActivity}" Style="{StaticResource NavItemIcon}" />
                                    <TextBlock Text="任务" Style="{StaticResource NavItemText}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettings}" Style="{StaticResource NavItemIcon}" />
                                    <TextBlock Text="设置" Style="{StaticResource NavItemText}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconUser}" Style="{StaticResource NavItemIcon}" />
                                    <TextBlock Text="账号" Style="{StaticResource NavItemText}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- 侧栏操作说明微文案 -->
                        <StackPanel Grid.Row="2" Margin="16,0,16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="按住" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0" MinWidth="34" VerticalAlignment="Center">
                                    <TextBlock Text="Shift" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="可多选文件" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="文件" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0" MinWidth="34" VerticalAlignment="Center">
                                    <TextBlock Text="右键" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="可选择免转存下载" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 侧栏底部：账号信息卡片 -->
                        <Border x:Name="AccountCard" Grid.Row="3" Margin="10,0,10,12" Style="{StaticResource MutedCard}" Padding="11" Cursor="Hand" MouseLeftButtonUp="OnAccountCardClick" ToolTip="点击进入「账号」页管理授权">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 头像 -->
                                <Border x:Name="AvatarBox" Grid.Column="0" Style="{StaticResource AvatarBorder}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="AvatarText" Text="?" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed">
                                            <Image.Clip>
                                                <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- 账号文字与容量条 -->
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountText" Text="未登录" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AccountHintText" Text="登录后可浏览网盘" FontSize="10.5" Margin="0,1,0,0" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel x:Name="CapacityBox" Margin="0,5,0,0">
                                        <ProgressBar x:Name="CapacityBar" Style="{StaticResource CapacityBar}" />
                                        <TextBlock x:Name="CapacityText" Text="" FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 刷新状态按钮 -->
                                <Button x:Name="AccountRefreshBtn" Grid.Column="2" Style="{StaticResource IconGhostButton}" VerticalAlignment="Top" Margin="2,0,0,0" Click="OnRefreshAccountClick" AutomationProperties.Name="刷新账号状态" ToolTip="刷新账号状态（昵称 / 容量）">
                                    <Path Data="{StaticResource IconRefresh}" Stretch="Uniform" Width="13" Height="13" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ────────── 右侧主内容选项卡 ────────── -->
                <TabControl x:Name="Tabs" Grid.Column="1" Style="{StaticResource NavTabControl}">

                    <!-- ================= 选项卡 0: 下载 ================= -->
                    <TabItem Style="{StaticResource HeadlessTabItem}">
                        <Grid Margin="20,16,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- 0 页头 -->
                                <RowDefinition Height="Auto" />  <!-- 1 平台与模式切换栏 -->
                                <RowDefinition Height="Auto" />  <!-- 2 留白/折叠位 -->
                                <RowDefinition Height="Auto" />  <!-- 3 分享链接解析卡片 -->
                                <RowDefinition Height="*" />     <!-- 4 网盘文件浏览器面板 -->
                                <RowDefinition Height="Auto" />  <!-- 5 底部操作栏 -->
                            </Grid.RowDefinitions>

                            <!-- 页头 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <Button Content="种子 / 磁力下载" Click="OnOpenTorrent" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" AutomationProperties.Name="种子和磁力下载" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="下载工作区" Style="{StaticResource PageTitleText}" />
                                    <TextBlock Text="选择网盘平台与模式，解析分享链接或直接管理云盘文件" Style="{StaticResource TertiaryText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <!-- 平台选择与模式切换栏 -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 网盘选择器 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择网盘：" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" Padding="2" ToolTip="选择网盘平台。切换平台会各自保留各自的登录状态。">
                                            <ComboBox x:Name="DownloadPanelBox" Width="185" Height="30" DisplayMemberPath="DisplayName" SelectedValuePath="Kind" SelectionChanged="OnPanelChanged" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboBoxItem}" AutomationProperties.Name="选择下载网盘" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 模式切换：分段单选 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border CornerRadius="10" Background="{DynamicResource SurfaceSunkenBrush}" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ShareModeRadio" Content="分享链接" Checked="OnModeChanged" Style="{StaticResource SegmentedRadio}" Margin="0" />
                                                <RadioButton x:Name="DriveModeRadio" Content="我的网盘" Checked="OnModeChanged" Style="{StaticResource SegmentedRadio}" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 占位行 (Row 2 留空自适应) -->

                            <!-- 分享链接解析卡片 (SharePanel) -->
                            <Border x:Name="SharePanel" Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 装饰性暗纹星芒 -->
                                    <Grid Grid.Row="0" IsHitTestVisible="False" Margin="-16">
                                        <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource PrimaryBrush}" Opacity="0.25" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,4" />
                                    </Grid>

                                    <!-- 输入控制行 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="分享链接" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Style="{StaticResource BodyText}" />

                                        <!-- 链接输入框 (集成扫码与一键清空) -->
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="LinkBox" Style="{StaticResource AppTextBox}" Height="42" Padding="12,7,58,7" AutomationProperties.Name="分享链接输入框" DataObject.Pasting="OnLinkBoxPasting" ToolTip="支持含提取码的完整链接，也可只粘贴链接再单独填提取码" />

                                            <!-- 扫码识别二维码图片按钮 -->
                                            <Button x:Name="ScanQrBtn" Click="OnScanQrClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" Width="22" Height="22" Cursor="Hand" Focusable="False" AutomationProperties.Name="识别二维码" ToolTip="识别二维码：把网盘分享二维码图片识别成链接（也可直接 Ctrl+V 粘贴截图）">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                                                        <Path Data="{StaticResource IconScan}" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Opacity" Value="0.85" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 输入框一键清空 -->
                                            <Button x:Name="LinkClearBtn" Click="OnClearLinkBox" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Width="22" Height="22" Cursor="Hand" Focusable="False" ToolTip="清空输入框">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                                                        <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=LinkBox}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- 提取码输入 -->
                                        <TextBlock Text="提取码" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,10,0" Style="{StaticResource BodyText}" />
                                        <TextBox x:Name="PassBox" Grid.Column="3" Width="120" Height="42" AutomationProperties.Name="提取码输入框" Style="{StaticResource AppTextBox}" ToolTip="无提取码可留空" />

                                        <!-- 解析按钮 -->
                                        <Grid Grid.Column="4" Margin="12,0,0,0">
                                            <Button x:Name="ParseBtn" Content="解析" Click="OnParseClick" Height="42" Padding="22,0" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" />
                                            <Grid IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconSparkle}" Fill="White" Opacity="0.55" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0" />
                                                <Path Data="{StaticResource IconSparkle}" Fill="White" Opacity="0.38" Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,6" />
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- 限速或状态警示提示 -->
                                    <TextBlock x:Name="SpeedNoteText" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource WarningBrush}" ToolTip="百度限速是服务端的令牌桶 + 线程限制策略，任何第三方工具都无法绕过" />
                                </Grid>
                            </Border>

                            <!-- 网盘文件浏览区域 (DrivePanel) -->
                            <Grid x:Name="DrivePanel" Grid.Row="4" Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- 工具栏 -->
                                    <RowDefinition Height="*" />     <!-- 文件列表 -->
                                </Grid.RowDefinitions>

                                <!-- 目录路径与操作工具条 -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 当前路径 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="15" Height="15" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <TextBlock x:Name="DrivePathText" Text="根目录" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>

                                    <!-- 搜索筛选与返回/刷新 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" Height="32" Width="190" Margin="0,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stretch="Uniform" Width="13" Height="13" Margin="9,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <TextBox x:Name="FileFilterBox" Grid.Column="1" TextChanged="OnFileFilterChanged" BorderThickness="0" Background="Transparent" Padding="6,0,8,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="{DynamicResource PrimaryBrush}" ToolTip="按名称筛选当前目录的文件/文件夹" />
                                            </Grid>
                                        </Border>
                                        <Button x:Name="DriveUpBtn" Click="OnUp" Style="{StaticResource ToolButton}" ToolTip="返回上级目录">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconArrowUp}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                <TextBlock Text="上级" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DriveRefreshBtn" Click="OnRefresh" Style="{StaticResource ToolButton}" Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 文件列表展示容器 -->
                                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                                    <Grid>
                                        <ListBox x:Name="FileList" SelectionMode="Extended" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource FileListItem}" PreviewMouseLeftButtonDown="OnListPreviewMouseDown" MouseRightButtonUp="OnFileListRightClick" MouseDoubleClick="OnFileListDoubleClick" SelectionChanged="OnFileSelectionSummaryChanged">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="下载选中" Click="OnDownloadSelected" />
                                                    <MenuItem x:Name="NoSaveDownloadMenuItem" Header="免转存下载（无法续传）" ToolTip="不往自己网盘写中转文件，省网盘空间。&#xA;但中断后无法续传 —— 分享凭证过期就取不到新链，只能重新解析分享从头下。" Click="OnDownloadSelectedNoSave" />
                                                    <MenuItem Header="获取直链…" Click="OnFetchLinks" />
                                                    <Separator Style="{StaticResource MenuSeparator}" />
                                                    <MenuItem Header="全选" Click="OnFileListSelectAll" />
                                                    <Separator Style="{StaticResource MenuSeparator}" />
                                                    <MenuItem Header="删除网盘文件…（仅我的网盘）" Click="OnDeleteCloudSelected" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IconFile}" />
                                                                    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                                            <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource BodyText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Style="{StaticResource TertiaryText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- 加载中状态 -->
                                        <StackPanel x:Name="FileLoadingState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path Data="{StaticResource IconSpinner}" Style="{StaticResource LoadingSpinner}" HorizontalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                                <Path.Triggers>
                                                    <EventTrigger RoutedEvent="Path.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Path.Triggers>
                                            </Path>
                                            <TextBlock Text="正在读取文件列表…" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource TertiaryText}" />
                                        </StackPanel>

                                        <!-- 空列表状态 -->
                                        <StackPanel x:Name="FileEmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Path Data="{StaticResource IconCloudOff}" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" Stroke="{DynamicResource BorderBrushStrong}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock x:Name="FileEmptyText" Text="还没有内容" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" />
                                            <TextBlock Text="粘贴分享链接并解析，或切换到「我的网盘」选择文件" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource TertiaryText}" FontSize="11.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 底部操作按钮栏 -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DownloadSelBtn" Click="OnDownloadSelected" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <TextBlock Text="下载选中" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DownloadMoreButton" Content="更多操作…" Tag="download" Click="OnOpenDrawer" Style="{StaticResource SecondaryButton}" />
                                <TextBlock x:Name="SelectionSummaryText" Text="请选择要下载的文件" Style="{StaticResource TertiaryText}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- ================= 选项卡 1: 任务 ================= -->
                    <TabItem Style="{StaticResource HeadlessTabItem}">
                        <Grid Margin="20,16,20,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- 0 页头 -->
                                <RowDefinition Height="Auto" />  <!-- 1 工具栏 -->
                                <RowDefinition Height="*" />     <!-- 2 任务列表 -->
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="下载任务" Style="{StaticResource PageTitleText}" />
                                <TextBlock Text="查看与管理正在下载或已完成的文件；右键任务可执行定位、打开或删除记录" Style="{StaticResource TertiaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="PauseAllBtn" Click="OnPauseAllOrResume" Style="{StaticResource ToolButton}" />
                                <Button x:Name="RetryFailedBtn" Click="OnRetryFailed" Style="{StaticResource ToolButton}" Margin="0" ToolTip="重新获取直链并重试失败的任务（已下载的分片会保留续传）">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <TextBlock Text="重试失败的" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenTaskDirBtn" Click="OnOpenOutDir" Style="{StaticResource ToolButton}" Margin="0" ToolTip="在资源管理器中打开下载目录">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <TextBlock Text="打开下载目录" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TaskMoreButton" Content="更多…" Tag="tasks" Click="OnOpenDrawer" Style="{StaticResource ToolButton}" Margin="8,0,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="TaskList" SelectionMode="Extended" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource TaskListItem}" PreviewMouseLeftButtonDown="OnListPreviewMouseDown" MouseRightButtonUp="OnTaskListRightClick" MouseDoubleClick="OnTaskListDoubleClick">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="暂停" Click="OnTaskPause" />
                                            <MenuItem Header="恢复" Click="OnTaskResume" />
                                            <MenuItem Header="取消" Click="OnTaskCancel" />
                                            <Separator Style="{StaticResource MenuSeparator}" />
                                            <MenuItem Header="播放文件" Click="OnOpenTaskFile" />
                                            <MenuItem Header="在资源管理器中定位" Click="OnLocateTaskFile" />
                                            <Separator Style="{StaticResource MenuSeparator}" />
                                            <MenuItem Header="删除本地文件…" Click="OnTaskDeleteLocal" />
                                            <MenuItem Header="仅移除记录" Click="OnTaskRemoveRecord" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Paused">
                                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailText}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="380" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                                    <Button Grid.Column="2" Click="OnTaskTogglePause" Tag="{Binding}" Style="{StaticResource TaskPauseButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <Button Grid.Column="3" Content="播放" Click="OnOpenTaskFile" Tag="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="用系统默认程序打开播放。">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanPlay}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="4" Content="定位" Click="OnLocateTaskFile" Tag="{Binding}" Style="{StaticResource GhostButton}" Margin="2,0,0,0" VerticalAlignment="Center" ToolTip="在资源管理器中选中该文件。" />
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="17,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Style="{StaticResource SlimProgressBar}" Value="{Binding Percent}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="72" Foreground="{DynamicResource PrimaryBrush}" Style="{StaticResource NumericText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DoneText}" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TertiaryText}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" Style="{StaticResource NumericText}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 任务为空时居中引导 -->
                                <StackPanel x:Name="TaskEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                    <Path Data="{StaticResource IconActivity}" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" Stroke="{DynamicResource BorderBrushStrong}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Text="暂无下载任务" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Text="在「下载」页解析链接并选择文件后，任务会出现在这里" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource TertiaryText}" FontSize="11.5" />
                                    <Button Content="去添加下载" Click="OnGoToDownloads" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ================= 选项卡 2: 设置 ================= -->
                    <TabItem Style="{StaticResource HeadlessTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <StackPanel Margin="20,16,20,24" HorizontalAlignment="Stretch">
                                <TextBlock Text="设置" Style="{StaticResource PageTitleText}" Margin="0,0,0,4" />
                                <TextBlock Text="所有改动即时生效，无需手动保存" Style="{StaticResource TertiaryText}" Margin="0,0,0,18" />

                                <!-- 外观个性化卡片 -->
                                <Border Style="{StaticResource PrimaryCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="个性化外观" Style="{StaticResource CardTitleText}" FontSize="15" Margin="0,0,0,4" />
                                        <TextBlock Text="界面外观风格。切换后立即原位生效" Style="{StaticResource TertiaryText}" Margin="0,0,0,14" />
                                        <Border HorizontalAlignment="Left" CornerRadius="12" Background="{DynamicResource SurfaceSunkenBrush}" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="AppTheme" Checked="OnThemeChanged" Style="{StaticResource SegmentedRadio}" AutomationProperties.Name="浅色主题" Margin="0" />
                                                <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="AppTheme" Checked="OnThemeChanged" Style="{StaticResource SegmentedRadio}" AutomationProperties.Name="深色主题" Margin="2,0,0,0" />
                                                <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" GroupName="AppTheme" Checked="OnThemeChanged" Style="{StaticResource SegmentedRadio}" AutomationProperties.Name="跟随系统主题" Margin="2,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ThemeHintText" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,10,0,0" Text="跟随系统时，Windows 切换深色/浅色，本程序会自动跟着变。" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Border x:Name="ThemeSwatchBg" Width="34" Height="22" CornerRadius="5" Background="{DynamicResource AppBgBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" />
                                            <Border x:Name="ThemeSwatchSurface" Width="34" Height="22" CornerRadius="5" Margin="6,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" />
                                            <Border x:Name="ThemeSwatchPrimary" Width="34" Height="22" CornerRadius="5" Margin="6,0,0,0" Background="{DynamicResource PrimaryBrush}" />
                                            <TextBlock Text="当前配色的底色、卡片色与星蓝主色" Style="{StaticResource TertiaryText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 抽屉设置入口按钮 -->
                                <Button Tag="settings" Click="OnOpenDrawer" Style="{StaticResource SettingsEntryButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下载与存储" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="下载保存目录、并发任务数、写入方式与窗口关闭行为" Style="{StaticResource TertiaryText}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Button>

                                <Button Tag="cache" Click="OnOpenDrawer" Style="{StaticResource SettingsEntryButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="分片与缓存" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="独立分片暂存位置与缓存目录显示方式" Style="{StaticResource TertiaryText}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Button>

                                <Button Tag="player" Click="OnOpenDrawer" Style="{StaticResource SettingsEntryButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="播放器与流式播放" Style="{StaticResource CardTitleText}" />
                                            <TextBlock Text="检测系统 VLC 安装状态与边下边播使用条件" Style="{StaticResource TertiaryText}" Margin="0,4,12,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= 选项卡 3: 账号 ================= -->
                    <TabItem Style="{StaticResource HeadlessTabItem}">
                        <ScrollViewer x:Name="LoginScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <StackPanel Margin="20,16,20,24" MaxWidth="960" HorizontalAlignment="Stretch">
                                <TextBlock Text="账号授权" Style="{StaticResource PageTitleText}" Margin="0,0,0,4" />
                                <TextBlock x:Name="LoginPageTitle" Text="登录后可浏览「我的网盘」、转存分享文件；不登录也能用直链下载" Style="{StaticResource TertiaryText}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                <ComboBox x:Name="AccountPanelBox" Width="220" DisplayMemberPath="DisplayName" SelectedValuePath="Kind" HorizontalAlignment="Left" Margin="0,0,0,16" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboBoxItem}" SelectionChanged="OnAccountPanelSelected" AutomationProperties.Name="选择账号所属网盘" />

                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="310" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左列：扫码登录卡片 -->
                                    <Border x:Name="QrCard" Grid.Column="0" Style="{StaticResource PrimaryCard}" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="{StaticResource IconQr}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="扫码登录" Style="{StaticResource CardTitleText}" Margin="7,0,0,0" FontSize="15" />
                                                </StackPanel>
                                                <TextBlock x:Name="QrHintText" Text="用手机「网盘 App」扫描二维码并在手机上确认" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                            </StackPanel>

                                            <!-- 二维码显示区 -->
                                            <Grid Grid.Row="1" Height="264" Margin="0,0,0,14" VerticalAlignment="Center">
                                                <Border x:Name="QrImageBox" Width="264" Height="264" Background="White" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="10" Padding="8" Visibility="Collapsed">
                                                    <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                                <Border x:Name="QrPlaceholderBox" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconQr}" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" Stroke="{DynamicResource BorderBrushStrong}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                        <TextBlock Text="点下方按钮获取登录二维码" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- 扫码按钮与状态提示 -->
                                            <Grid Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <Button x:Name="QrLoginBtn" Click="OnQrLogin" Style="{StaticResource PrimaryButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconQr}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextOnPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                            <TextBlock Text="获取二维码" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>

                                                <Border x:Name="QrStatusBox" Grid.Row="1" Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Visibility="Collapsed" Background="{DynamicResource SurfaceSunkenBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="QrStatusIcon" Data="{StaticResource IconClock}" Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        <TextBlock x:Name="QrStatusText" Text="" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 右列：当前状态、操作入口与说明 -->
                                    <Grid Grid.Column="1" Margin="16,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 当前登录状态 -->
                                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="当前状态" Style="{StaticResource CardTitleText}" Margin="0,0,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="LoginAvatarBox" Grid.Column="0" Style="{StaticResource AvatarBorder}" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock x:Name="LoginAvatarText" Text="?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image x:Name="LoginAvatarImage" Stretch="UniformToFill" Visibility="Collapsed">
                                                                <Image.Clip>
                                                                    <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                                                                </Image.Clip>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="LoginWhoText" Text="未登录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="LoginSubText" Text="扫码、输入账号密码或配置连接即可登录" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 登录动作行 -->
                                                <WrapPanel x:Name="LoginActionRow" Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="LoginBtn" Content="扫码登录" Click="OnAccountLoginAction" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                                    <Button x:Name="AccountsBtn" Content="切换 / 管理账号" Click="OnOpenAccounts" Style="{StaticResource SecondaryButton}" ToolTip="管理已记住的网盘账号和 WebDAV 连接" Margin="0,0,8,8" />
                                                    <Button x:Name="WebDavConfigureButton" Content="接入 / 编辑 WebDAV" Click="OnConfigureWebDav" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                                    <Button x:Name="NativeQrLoginButton" Content="扫码登录…" Click="OnNativeQrLogin" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                                    <Button x:Name="NativePasswordLoginButton" Content="账号密码登录…" Click="OnNativePasswordLogin" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                                    <Button x:Name="NativeConfigureButton" Content="高级凭据…" Click="OnConfigureNativeCloud" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                                    <Button x:Name="AccountMoreButton" Content="更多登录方式…" Tag="account" Click="OnOpenDrawer" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 小贴士卡片 -->
                                        <Border Grid.Row="1" Style="{StaticResource InfoBanner}" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid IsHitTestVisible="False">
                                                    <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource PrimaryBrush}" Opacity="0.55" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                                                    <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource PrimaryBrush}" Opacity="0.38" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,60,0" />
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="小贴士" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />
                                                    <TextBlock Style="{StaticResource ProseText}" Text="· 账号保存在本机；连接网盘时，授权凭据仅用于对应平台的服务请求。" />
                                                    <TextBlock Style="{StaticResource ProseText}" Margin="0,4,0,0" Text="· 授权过期时，请按所选平台的说明重新扫码、导入令牌或更新连接配置。" />
                                                    <TextBlock Style="{StaticResource ProseText}" Margin="0,4,0,0" Text="· 各平台分别记忆账号；有未结束任务时，先完成或取消任务再更换该平台账号。" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ================= 2. 全局抽屉面板 (DrawerOverlay) ================= -->
            <Grid x:Name="DrawerOverlay" Grid.Row="1" Panel.ZIndex="50" Visibility="Collapsed" Grid.RowSpan="2">
                <!-- 半透明遮罩背景 -->
                <Border Background="#66070A14" MouseLeftButtonDown="OnDrawerBackdropClick" />

                <!-- 浮动抽屉表面 -->
                <Border x:Name="DrawerSurface" Width="560" HorizontalAlignment="Right" Margin="14" Padding="24" CornerRadius="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" Button.Click="OnDrawerSurfaceAction">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="DrawerCloseButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="关闭 ✕" Click="OnCloseDrawer" Style="{StaticResource GhostButton}" AutomationProperties.Name="关闭操作面板" />
                            <TextBlock x:Name="DrawerTitle" Style="{StaticResource PageTitleText}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock x:Name="DrawerDescription" Grid.Row="1" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <ScrollViewer x:Name="DrawerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                            <Grid>
                                <!-- 下载操作抽屉 -->
                                <StackPanel x:Name="DownloadDrawerContent" Visibility="Collapsed">
                                    <Button x:Name="DownloadAllBtn" Click="OnDownloadAll" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconDownload}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="下载全部" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FetchLinksBtn" Click="OnFetchLinks" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconLink}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="获取直链" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource TertiaryText}" TextWrapping="Wrap">
                                        <Run Text="获取直链后可导出为 纯直链 / curl 命令 / aria2c 命令 / Motrix 界面 " />
                                        <Run Text="（后三者自带 UA 与 Cookie）" Foreground="{DynamicResource DangerBrush}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- 任务工具抽屉 -->
                                <StackPanel x:Name="TasksDrawerContent" Visibility="Collapsed">
                                    <Button x:Name="HistoryBtn" Click="OnOpenHistory" Style="{StaticResource ToolButton}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconHistory}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock Text="下载历史" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DiagBtn" Click="OnOpenDiagnostics" Style="{StaticResource ToolButton}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconDiagnostics}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock Text="诊断面板" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearDoneBtn" Content="清空已完成" Click="OnClearDone" Style="{StaticResource ToolButton}" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- 运行日志抽屉 -->
                                <StackPanel x:Name="LogsDrawerContent" Visibility="Collapsed">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="420" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="运行日志" Style="{StaticResource SectionLabel}" Margin="0" />
                                            <TextBlock Text="下载 / 解析 / 报错记录" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource LogTextBox}" />
                                    </Grid>
                                </StackPanel>

                                <!-- 下载与网络设置抽屉 -->
                                <StackPanel x:Name="SettingsDrawerContent" Visibility="Collapsed">
                                    <Border Style="{StaticResource PrimaryCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="下载与网络参数" Style="{StaticResource CardTitleText}" FontSize="15" Margin="0,0,0,4" />
                                            <TextBlock Text="管理并发连接、保存目录与分片写入模式" Style="{StaticResource TertiaryText}" Margin="0,0,0,18" />

                                            <TextBlock Text="并发与任务" Style="{StaticResource SectionLabel}" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="单文件并发连接数" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="ThreadsBox" Grid.Column="1" MaxWidth="340" HorizontalAlignment="Left" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboBoxItem}" SelectionChanged="OnSettingChanged">
                                                    <ComboBoxItem Content="16  — 省网保守" />
                                                    <ComboBoxItem Content="32  — 保守，够用" />
                                                    <ComboBoxItem Content="64  — 默认" />
                                                    <ComboBoxItem Content="128 — 较高并发" />
                                                    <ComboBoxItem Content="256 — 高并发" />
                                                    <ComboBoxItem Content="512 — 最高并发" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="同时下载任务数" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="ConcurrentBox" Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left" Style="{StaticResource AppTextBox}" LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown" />
                                            </Grid>

                                            <TextBlock Text="窗口与后台" Style="{StaticResource SectionLabel}" />
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="关闭按钮行为" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="CloseActionBox" Grid.Column="1" MaxWidth="340" HorizontalAlignment="Left" Style="{StaticResource AppComboBox}" ItemContainerStyle="{StaticResource AppComboBoxItem}" SelectionChanged="OnSettingChanged">
                                                    <ComboBoxItem Content="每次询问" />
                                                    <ComboBoxItem Content="最小化到托盘（后台继续下载）" />
                                                    <ComboBoxItem Content="直接退出程序" />
                                                </ComboBox>
                                            </Grid>

                                            <TextBlock Text="存储与写入" Style="{StaticResource SectionLabel}" />
                                            <Grid Margin="0,0,0,16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="下载目录" Style="{StaticResource FieldLabel}" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />
                                                <TextBox x:Name="OutDirBox" Grid.Column="0" Style="{StaticResource AppTextBox}" LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown" Grid.Row="1" />
                                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseOutDir" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Grid.Row="1" />
                                                <Button x:Name="OpenOutDirBtn" Click="OnOpenOutDir" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Grid.Row="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        <TextBlock Text="打开" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="分片写入方式" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="点击下方卡片选择模式" Style="{StaticResource TertiaryText}" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton x:Name="WriteModeSharedRadio" GroupName="WriteMode" Checked="OnSettingChanged" Style="{StaticResource WriteModeCard}" Margin="0,0,5,0">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="共写同一文件" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <Border Margin="6,0,0,0" CornerRadius="4" Padding="5,0,5,1" VerticalAlignment="Center" Background="{DynamicResource SuccessLightBrush}">
                                                                        <TextBlock Text="推荐" FontSize="10" Foreground="{DynamicResource SuccessBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="边下边写同一个文件，不多占存储空间。" Style="{StaticResource ProseText}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="下载时无法进行流式边下边看。" Style="{StaticResource TertiaryText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </RadioButton>

                                                        <RadioButton x:Name="WriteModeSegmentedRadio" Grid.Column="1" GroupName="WriteMode" Checked="OnSettingChanged" Style="{StaticResource WriteModeCard}" Margin="5,0,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="独立分片 + 边合并" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="每片先下成小文件，再按顺序拼成完整文件。" Style="{StaticResource ProseText}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="临时多占一份空间，但支持边下边看。" Style="{StaticResource TertiaryText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource TertiaryText}" FontSize="11" Margin="1,8,0,0" TextWrapping="Wrap" Text="完成后再打开选「共写同一文件」；需要边下边播选「独立分片」。" />
                                                </StackPanel>
                                            </Border>

                                            <CheckBox x:Name="AutoCleanCheck" Content="下载完成后自动清理云盘转存文件" Style="{StaticResource AppCheckBox}" Click="OnSettingChanged" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 分片与缓存抽屉 -->
                                <StackPanel x:Name="CacheDrawerContent" Visibility="Collapsed">
                                    <Border Style="{StaticResource MutedCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="分片与缓存" Style="{StaticResource CardTitleText}" Margin="0,0,0,12" />
                                            <TextBlock Text="分片/缓存根目录" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PartsRootBox" Grid.Column="0" Style="{StaticResource AppTextBox}" LostFocus="OnSettingChanged" KeyDown="OnSettingKeyDown" ToolTip="留空 = 分片与目标文件同目录（默认）。指定后可把分片集中到另一块盘（如 SSD）。" />
                                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowsePartsRoot" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                                                <Button x:Name="OpenPartsRootBtn" Click="OnOpenPartsRoot" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="在资源管理器中打开分片/缓存根目录。">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        <TextBlock Text="打开" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Style="{StaticResource ProseText}" Margin="0,8,0,12" Text="留空 = 分片与目标文件同目录（默认）。指定后可把分片集中到另一块盘。" />
                                            <CheckBox x:Name="HidePartsCheck" Content="隐藏分片目录" Style="{StaticResource AppCheckBox}" Click="OnSettingChanged" ToolTip="只影响新建的分片目录是否隐藏，不影响下载功能。默认勾选。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 播放器检测抽屉 -->
                                <StackPanel x:Name="PlayerDrawerContent" Visibility="Collapsed">
                                    <Border Style="{StaticResource MutedCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="播放器（边下边播用）" Style="{StaticResource CardTitleText}" Margin="0,0,0,10" />
                                            <TextBlock x:Name="PlayerStatusText" TextWrapping="Wrap" Style="{StaticResource ProseText}" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button x:Name="GetVlcBtn" Content="打开 VLC 下载页" Click="OnGetVlc" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                                <Button x:Name="RecheckPlayerBtn" Content="重新检测" Click="OnRecheckPlayer" Style="{StaticResource SecondaryButton}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource ProseText}" Text="ZERA 不内置播放器（保持轻量）。推荐 VLC：免费、开源、格式全，而且它以共享模式打开文件，不会干扰写盘。没装 VLC 时，「打开」按钮会回退到系统默认程序。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 账号工具抽屉 -->
                                <StackPanel x:Name="AccountDrawerContent" Visibility="Collapsed">
                                    <Border x:Name="BaiduCookieCard" VerticalAlignment="Stretch" Style="{StaticResource PrimaryCard}" Visibility="Collapsed" Margin="0,0,0,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconQr}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <TextBlock Text="手动导入百度 Cookie（备用）" Style="{StaticResource CardTitleText}" Margin="7,0,0,0" FontSize="15" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,0,0,10" Text="扫码登录更方便；若扫码不可用，再从浏览器复制 Cookie（含 BDUSS）导入。" />
                                            <TextBlock Style="{StaticResource TertiaryText}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" Text="获取：浏览器登录 pan.baidu.com → F12「网络」→ 点任一 pan.baidu.com 请求 → 请求头里复制 Cookie 整串。" />
                                            <TextBox x:Name="BaiduCookieBox" Style="{StaticResource AppTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" AutomationProperties.Name="百度 Cookie 输入框" ToolTip="粘贴浏览器里的完整 Cookie 串" />
                                            <Button x:Name="BaiduCookieLoginBtn" Content="导入并登录" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="OnBaiduCookieLogin" AutomationProperties.Name="导入百度 Cookie 并登录" />
                                            <TextBlock x:Name="BaiduLoginStatus" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,10,0,0" Text="Cookie 只保存在本机（DPAPI 加密），不会上传。" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="CookieImportCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="导入 Cookie" Style="{StaticResource CardTitleText}" Margin="0,0,0,6" />
                                            <TextBlock Text="扫码不方便时，可从浏览器复制网盘 Cookie 粘贴进来登录；也可以直接从 Cookie 文件导入。" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <TextBox x:Name="CookieImportBox" Height="72" Style="{StaticResource AppTextBoxMultiline}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="ImportCookieBtn" Content="导入并登录" Click="OnImportCookie" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="BaiduMembershipButton" Content="百度会员 / 流量查询" Click="OnQueryBaiduMembership" Style="{StaticResource SecondaryButton}" Margin="0,0,0,14" />

                                    <StackPanel x:Name="CookieFileTools">
                                        <TextBlock Text="凭据文件" Style="{StaticResource CardTitleText}" Margin="0,4,0,10" />
                                        <WrapPanel x:Name="CookieFileActions">
                                            <Button x:Name="ImportCookieFileBtn" Click="OnImportCookieFile" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" ToolTip="从文件读取 Cookie 并直接登录。&#xA;支持 .txt（原始 Cookie 串）和 .json（浏览器扩展导出）。">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolder}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <TextBlock Text="从文件导入" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ExportCookieBtn" Click="OnExportCookie" Style="{StaticResource SecondaryButton}" ToolTip="把当前登录 Cookie 导出成桌面上的 txt 文件（不占用剪贴板）。" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFile}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <TextBlock Text="导出 Cookie 文件" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Text="导出的 Cookie 文件含登录凭据，请妥善保管。" Style="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 3. 底部状态栏 ================= -->
            <Border Grid.Row="2" Padding="16,5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="查看日志 ›" Tag="logs" Click="OnOpenDrawer" Style="{StaticResource GhostButton}" Padding="10,3" />
                    <TextBlock x:Name="ActivityStatusText" Text="就绪 · 选择网盘，解析链接或浏览文件" Style="{StaticResource TertiaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
